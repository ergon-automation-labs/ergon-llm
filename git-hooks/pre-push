#!/bin/bash
# Git pre-push hook for bot_army_llm
# Validates code compiles and builds release before pushing to GitHub
# Full test suite runs in Jenkins/CI (requires database)

set -e

echo "🔍 Running pre-push checks..."
echo ""

# Check if we're pushing to main
read local_ref local_oid remote_ref remote_oid
if [[ $remote_ref == "refs/heads/main" ]]; then
  echo "⚠️  Pushing to main branch - validating and building release..."
  echo ""

  # Ensure dependencies are up to date
  echo "📦 Installing dependencies..."
  mix deps.get || {
    echo "❌ Failed to install dependencies"
    exit 1
  }

  # Check for compilation issues
  echo ""
  echo "🔨 Compiling code..."
  mix compile --force || {
    echo "❌ Compilation failed - push aborted"
    exit 1
  }

  # Quick linting check
  echo ""
  echo "📝 Running linter..."
  mix credo --strict || {
    echo "⚠️  Linting issues found (non-blocking, will fail in CI)"
  }

  # Build OTP release
  echo ""
  echo "📦 Building OTP release..."
  MIX_ENV=prod mix release --overwrite || {
    echo "❌ Release build failed - push aborted"
    exit 1
  }

  # Extract version and create GitHub release
  echo ""
  echo "🚀 Publishing release to GitHub..."
  APP_NAME="bot_army_llm"
  RELEASE_DIR="_build/prod/rel/$APP_NAME"
  # Get version from start_erl.data (format: "OTP_VERSION APP_VERSION")
  VERSION=$(cat "$RELEASE_DIR/releases/start_erl.data" | awk '{print $2}')
  if [ -z "$VERSION" ]; then
    echo "❌ Could not extract version from release"
    exit 1
  fi
  echo "Version: $VERSION"

  # Create tarball with app name
  tar -czf "${APP_NAME}-${VERSION}.tar.gz" -C _build/prod/rel "$APP_NAME/" || {
    echo "❌ Failed to create tarball"
    exit 1
  }
  echo "✓ Tarball created: ${APP_NAME}-${VERSION}.tar.gz"

  # Create GitHub release
  gh release create v$VERSION "${APP_NAME}-${VERSION}.tar.gz" \
    --title "Release v$VERSION" \
    --notes "LLM Bot Elixir release v$VERSION. Automatically deployed by Jenkins." \
    --draft=false || {
    echo "⚠️  Release already exists or GitHub publish failed"
    echo "Continuing with push anyway..."
  }
  echo "✓ Release published to GitHub"

  echo ""
  echo "✅ All checks passed, release built and published!"
  echo "📤 Proceeding with push..."
else
  echo "ℹ️  Pushing to feature branch - skipping full test suite"
  echo "Tests will run on GitHub Actions"
fi

echo ""
exit 0
